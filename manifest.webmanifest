{
  "name": "Sketchboard",
  "short_name": "Sketchboard",
  "description": "Whiteboards and diagrams that live on your device and work offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8f5ee",
  "theme_color": "#f8f5ee",
  "categories": ["productivity", "graphics"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New board", "url": "./#/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "All boards", "url": "./#/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
